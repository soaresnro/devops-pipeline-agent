# Override de {{ application_name }} para o ambiente {{ env }} (aninhado sob microservice-chart).
# Skeleton no modelo do time - ATUALIZE clientId da workload identity e env conforme o
# ambiente. Os hosts/secrets seguem a convencao epharma (dominio derivado por ambiente);
# ajuste se o servico usar outro dominio.
microservice-chart:
  image:
    repository: "acraks{{ env }}eastus.azurecr.io/{{ app_name }}"
    pullPolicy: IfNotPresent
    tag: "__imageTag__"  # substituido pela pipeline

  ingresses:
    - name: {{ application_name }}
      enabled: true
      className: private-nginx
      tls:
        - hosts:
            - {{ ingress_primary_host }}
          secretName: {{ ingress_primary_secret }}
      rules:
        - host: {{ ingress_primary_host }}
          paths:
            - path: /
              pathType: Prefix
              port: {{ container_port }}

    - name: {{ application_name }}-legacy
      enabled: true
      className: private-legacy-nginx
      tls:
        - hosts:
            - {{ ingress_legacy_host }}
          secretName: {{ ingress_legacy_secret }}
      rules:
        - host: {{ ingress_legacy_host }}
          paths:
            - path: /
              pathType: Prefix
              port: {{ container_port }}

  replicaCount: 1

  pdb:
    enabled: false

  serviceAccount:
    create: true
    name: sa-{{ namespace }}-{{ application_name }}

  workloadIdentity:
    clientId: ""  # ATUALIZE com o clientId da managed identity de {{ env }}

  environment: {{ env }}
{%- if datadog %}

  podLabels:
    # Unified service tagging do Datadog (so uat/prod).
    tags.datadoghq.com/env: "{{ datadog['env'] }}"
    tags.datadoghq.com/service: "{{ datadog['service'] }}"
    tags.datadoghq.com/version: "{{ datadog['version'] }}"
{%- endif %}

  env:
    # Defaults por ambiente; adicione outras variaveis da aplicacao conforme necessario.
{%- for key, value in app_env.items() %}
    {{ key }}: "{{ value }}"
{%- endfor %}

  autoscaling:
    enabled: false

    minReplicas: 2
    maxReplicas: 3

    targetCPUUtilizationPercentage: 60
    targetMemoryUtilizationPercentage: 70

    behavior:
      scaleUp:
        stabilizationWindowSeconds: 30
        selectPolicy: Max

        policies:
          - type: Percent
            value: 100
            periodSeconds: 60

          - type: Pods
            value: 3
            periodSeconds: 60

      scaleDown:
        stabilizationWindowSeconds: 300
        selectPolicy: Max

        policies:
          - type: Percent
            value: 50
            periodSeconds: 60
