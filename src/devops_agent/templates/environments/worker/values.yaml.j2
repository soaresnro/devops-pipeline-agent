# Override de {{ app_name }} para o ambiente {{ env }} (aninhado sob worker-chart).
# Skeleton - ATUALIZE clientId da workload identity e env conforme o ambiente.
worker-chart:
  image:
    repository: "acraks{{ env }}eastus.azurecr.io/{{ app_name }}"  # ATUALIZE se o nome da imagem diferir
    pullPolicy: IfNotPresent
    tag: "__imageTag__"  # substituido pela pipeline

  serviceAccount:
    create: true
    name: sa-{{ app_name }}

  workloadIdentity:
    clientId: ""  # ATUALIZE com o clientId da managed identity de {{ env }}

  environment: {{ env }}
{%- if datadog %}

  podLabels:
    # Unified service tagging do Datadog (so uat/prod).
    tags.datadoghq.com/env: "{{ datadog['env'] }}"
    tags.datadoghq.com/service: "{{ datadog['service'] }}"
    tags.datadoghq.com/version: "{{ datadog['version'] }}"
{%- endif %}

{%- if app_env %}

  env:
    # Variaveis de runtime; adicione outras da aplicacao conforme necessario.
{%- for key, value in app_env.items() %}
    {{ key }}: "{{ value }}"
{%- endfor %}
{%- else %}

  env: {}  # ATUALIZE com as variaveis da aplicacao
{%- endif %}
