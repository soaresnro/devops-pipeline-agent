apiVersion: v2
name: {{ app_name }}
description: {{ app_name }} ({{ app_type }})
type: application
version: 0.1.0
appVersion: "1.0.0"

# A base chart e vendorizada empacotada em charts/{{ base_chart_name }}-{{ base_chart_version }}.tgz
# (com Chart.lock); a dependency aponta para o repo do time (AksHelmBaseCharts) e o helm
# resolve pelo .tgz vendorizado.
dependencies:
  - name: {{ base_chart_name }}
    version: "{{ base_chart_version }}"
    repository: "file://../../../../AksHelmBaseCharts/base-charts/{{ base_chart_name }}"
