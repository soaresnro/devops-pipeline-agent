# Pipeline gerada automaticamente pelo devops-pipeline-agent
# App: {{ app_name }} | Stack: .NET {{ dotnet_version }} | Namespace: {{ namespace }}
# NAO edite manualmente - este arquivo apenas referencia o template centralizado.

name: $(Build.SourceBranchName).$(Build.BuildId)

trigger:
  branches:
    include:
      - develop
      - release/*
      - hotfix/*
      - feature/*

# Os manifests do Helm vivem neste proprio repositorio (helm/base +
# helm/environments); a pipeline os le do checkout self, sem resource dedicado.
resources:
  repositories:
    - repository: templates
      type: git
      name: {{ devops_templates_repo_name }}
      ref: refs/heads/{{ devops_templates_branch }}

pool:
  name: agt_pool_linux_vmss

variables:
  - group: Sonarqube
  - group: DevOpsShared
  - group: ServiceConnections
  - group: k8s-dev
  - group: k8s-qa
  - group: k8s-uat
  - group: k8s-prod

  - name: SQ_PROJECT_KEY
    value: $(Build.Repository.Name)
  - name: buildConfiguration
    value: 'Release'

extends:
  template: {{ pipeline_template_path }}@templates
  parameters:
    # Habilitar integracao com o APIM (perguntado no fluxo; sempre false fora de api)
    enableApim: {{ 'true' if uses_apim else 'false' }}

    # Defina valores da aplicacao
    applicationName: '{{ application_name }}'
    namespace: '{{ namespace }}'

    # Estrategia de deploy
    deploymentStrategy: 'rolling'

    # Sem APIM (enableApim: false) os valores saem vazios - o template condiciona os
    # jobs de import a enableApim + pathApiManagementService nao vazio.
    pathApiManagementService: '{{ apim_path }}'
{%- if app_type == 'api' %}

    # apiId do APIM por ambiente
    apiIdDev: '{{ api_ids['dev'] }}'
    apiIdQa: '{{ api_ids['qa'] }}'
    apiIdUat: '{{ api_ids['uat'] }}'
    apiIdProd: '{{ api_ids['prod'] }}'
{%- endif %}

    # Tipo e stack
    ApplicationType: 'dotnet'
    projectType: 'webapi'
    dotNetVersion: '{{ dotnet_version }}'

    # Variaveis para Docker
    imageName: '$(Build.Repository.Name)'
    imageTag: '$(Build.SourceBranchName)-$(Build.BuildId)'
