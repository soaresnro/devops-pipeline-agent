# syntax=docker/dockerfile:1.7
# Dockerfile Python (runtime-only) gerado para {{ app_name }} ({{ app_type }})
# A pipeline instala deps/buildva e usa a saida como contexto do build (COPY . .).
FROM python:3.12-alpine AS runtime

WORKDIR /app
{% if app_type == 'api' %}
EXPOSE 8080
{% endif %}
RUN apk add --no-cache tzdata ca-certificates wget && update-ca-certificates

# Timezone
ENV TZ=America/Sao_Paulo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY . .
{% if app_type == 'api' %}
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1
{% endif %}
# Ajuste para o entrypoint real da aplicacao.
CMD ["python", "-m", "{{ app_name }}"]
