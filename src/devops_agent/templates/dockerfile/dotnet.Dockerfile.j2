# syntax=docker/dockerfile:1.7
# Dockerfile .NET (runtime-only) gerado para {{ app_name }} ({{ app_type }})
# A pipeline publica a aplicacao e usa a saida como contexto do build (COPY . .).
{% if app_type == 'api' -%}
FROM mcr.microsoft.com/dotnet/aspnet:{{ dotnet_image_tag }}-alpine AS runtime
{%- else -%}
FROM mcr.microsoft.com/dotnet/runtime:{{ dotnet_image_tag }}-alpine AS runtime
{%- endif %}

WORKDIR /app
{% if app_type == 'api' %}
EXPOSE 8080
{% endif %}
# Dependencias basicas (Alpine)
RUN apk add --no-cache \
    tzdata \
    ca-certificates \
    libc6-compat \
    libstdc++ \
    wget \
    icu-libs \
    && update-ca-certificates

# Timezone padrao da imagem (a variavel TZ vive no values de cada ambiente)
RUN ln -snf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime \
    && echo America/Sao_Paulo > /etc/timezone

# Unica ENV do Dockerfile: descreve a imagem, nao o ambiente. As demais variaveis de
# runtime (ASPNETCORE_URLS, globalizacao, logs, TZ) ficam em helm/environments/<env>/values.yaml,
# para serem ajustaveis por ambiente sem rebuild da imagem.
ENV DOTNET_RUNNING_IN_CONTAINER=true

COPY . .
{% if app_type == 'api' %}
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1
{% endif %}
ENTRYPOINT ["dotnet", "{{ dotnet_entrypoint }}"]
