# syntax=docker/dockerfile:1.7
# Dockerfile .NET (runtime-only) gerado para {{ app_name }} ({{ app_type }})
# A pipeline publica a aplicacao e usa a saida como contexto do build (COPY . .).
{% if app_type == 'api' -%}
FROM mcr.microsoft.com/dotnet/aspnet:{{ dotnet_image_tag }}-alpine AS runtime
{%- else -%}
FROM mcr.microsoft.com/dotnet/runtime:{{ dotnet_image_tag }}-alpine AS runtime
{%- endif %}

WORKDIR /app
{% if app_type == 'api' %}
EXPOSE 8080
{% endif %}
# Dependencias basicas (Alpine)
RUN apk add --no-cache \
    tzdata \
    ca-certificates \
    libc6-compat \
    libstdc++ \
    wget \
    icu-libs \
    && update-ca-certificates

# Timezone
ENV TZ=America/Sao_Paulo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
{% if app_type == 'api' %}
# ASP.NET Core
ENV ASPNETCORE_URLS=http://+:8080
{% endif %}
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Logs
ENV Logging__LogLevel__Default=Warning \
    Logging__LogLevel__Microsoft=Warning \
    Logging__LogLevel__Microsoft.Hosting.Lifetime=Information

COPY . .
{% if app_type == 'api' %}
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1
{% endif %}
ENTRYPOINT ["dotnet", "{{ dotnet_entrypoint }}"]
