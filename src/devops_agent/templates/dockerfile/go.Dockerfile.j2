# syntax=docker/dockerfile:1.7
# Dockerfile Go gerado para {{ app_name }} ({{ app_type }})
# Ajuste a base image, o build e o entrypoint conforme a stack real.

ARG BUILD_IMAGE=golang:1.23-alpine
ARG RUNTIME_IMAGE=alpine:3.20

FROM ${BUILD_IMAGE} AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -o /out/{{ app_name }} .

FROM ${RUNTIME_IMAGE} AS runtime
WORKDIR /app
COPY --from=build /out/{{ app_name }} ./{{ app_name }}

RUN addgroup -S app && adduser -S app -G app
USER app

{% if app_type == 'api' -%}
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:8080/healthz || exit 1
{%- elif app_type == 'worker' -%}
# Workers nao expoem porta. Probe via processo.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD pgrep -f {{ app_name }} > /dev/null || exit 1
{%- else -%}
# CronJobs rodam ate concluir e saem; sem porta exposta e sem probe de container.
{%- endif %}

ENTRYPOINT ["./{{ app_name }}"]
