# syntax=docker/dockerfile:1.7
# Dockerfile gerado para aplicacao tipo CronJob ({{ app_name }})
# Ajuste a base image e o build conforme a stack real da sua aplicacao.

ARG RUNTIME_IMAGE=mcr.microsoft.com/dotnet/runtime:8.0-alpine
ARG BUILD_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0-alpine

FROM ${BUILD_IMAGE} AS build
WORKDIR /src
COPY . .
RUN dotnet publish -c Release -o /app --no-self-contained

FROM ${RUNTIME_IMAGE} AS runtime
WORKDIR /app
COPY --from=build /app .

RUN addgroup -S app && adduser -S app -G app
USER app

ENV DOTNET_RUNNING_IN_CONTAINER=true

# CronJobs rodam ate concluir e saem; sem porta exposta e sem probe de container.
ENTRYPOINT ["dotnet", "{{ app_name }}.dll"]
