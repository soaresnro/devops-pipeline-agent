# syntax=docker/dockerfile:1.7
# Dockerfile gerado para aplicacao tipo API ({{ app_name }})
# Ajuste a base image e o build conforme a stack real da sua aplicacao.

ARG RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:8.0-alpine
ARG BUILD_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0-alpine

FROM ${BUILD_IMAGE} AS build
WORKDIR /src
COPY . .
RUN dotnet publish -c Release -o /app --no-self-contained

FROM ${RUNTIME_IMAGE} AS runtime
WORKDIR /app
COPY --from=build /app .

RUN addgroup -S app && adduser -S app -G app
USER app

ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_RUNNING_IN_CONTAINER=true

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:8080/healthz || exit 1

ENTRYPOINT ["dotnet", "{{ app_name }}.dll"]
