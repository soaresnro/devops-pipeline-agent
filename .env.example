# ============================================================
# Azure DevOps
# ============================================================
# Organizacao alvo (allowlist rigido - apenas esta org sera aceita)
AZDO_ORG=contoso
# Service Principal / PAT usado pelo agente para chamar a REST API
AZDO_AUTH_MODE=pat
AZDO_PAT=
# Quando AZDO_AUTH_MODE=sp:
AZDO_SP_TENANT_ID=
AZDO_SP_CLIENT_ID=
AZDO_SP_CLIENT_SECRET=

# Repositorio do time de DevOps onde ficam os Helm charts e templates de pipeline
DEVOPS_TEMPLATES_REPO_URL=https://dev.azure.com/contoso/Platform/_git/devops-templates
DEVOPS_TEMPLATES_TAG=v1
DEVOPS_TEMPLATES_REVIEWERS=devops-team

# ============================================================
# Azure OpenAI (opcional na POC - sem isso, o CLI funciona em modo determinstico)
# ============================================================
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

# ============================================================
# Runtime
# ============================================================
LOG_LEVEL=INFO
WORKDIR_ROOT=./.tmp/sessions
SESSION_TTL_SECONDS=3600
