# ============================================================
# Azure DevOps
# ============================================================
# Organizacao alvo (allowlist rigido - apenas esta org sera aceita)
AZDO_ORG=contoso
# Modo de auth: 'pat' (POC/dev) ou 'sp' (Service Principal + OBO, producao).
AZDO_AUTH_MODE=pat
AZDO_PAT=
# Quando AZDO_AUTH_MODE=sp: TENANT_ID e CLIENT_ID sao obrigatorios. CLIENT_SECRET
# e OPCIONAL: com secret, app token e OBO usam o secret; SEM secret, ambos usam a
# Managed Identity (federated identity credential) - sem segredo no Key Vault.
AZDO_SP_TENANT_ID=
AZDO_SP_CLIENT_ID=
AZDO_SP_CLIENT_SECRET=
# Token de assercao (JWT) do usuario humano, obtido pelo front-end (Teams/SPA) e
# trocado via OBO para verificar a permissao do usuario antes do clone. Em dev pode
# ser colado manualmente. Tambem aceito via flag --user-token.
AZDO_AGENT_USER_ASSERTION=
# Alternativa ao AZDO_AGENT_USER_ASSERTION no modo sp: app PUBLICO para login
# interativo (device code) que obtem a assercao do usuario na hora. Se setado e
# nenhum token foi passado, a CLI faz o login automaticamente.
AZDO_LOGIN_CLIENT_ID=
# Escopo pedido no login (audience = app confidencial do agente).
# Default: "{AZDO_SP_CLIENT_ID}/.default".
AZDO_AGENT_API_SCOPE=

# Repositorio dos templates de pipeline (referenciado por tag no azure-pipelines.yaml).
DEVOPS_TEMPLATES_REPO_URL=https://dev.azure.com/contoso/Platform/_git/devops-templates
DEVOPS_TEMPLATES_TAG=v1
DEVOPS_TEMPLATES_REVIEWERS=devops-team
# Repo onde os Helm charts sao escritos (PR). Se vazio, usa DEVOPS_TEMPLATES_REPO_URL.
DEVOPS_HELM_REPO_URL=
# Branch alvo do repo do Helm (clone + PR). Ex.: master.
DEVOPS_HELM_REPO_BRANCH=main
# Template de pipeline (no devops-templates) escolhido pela linguagem detectada.
# Sem caminho proprio para a linguagem, usa DEVOPS_TEMPLATE_DEFAULT. web reaproveita
# o de node (build Node -> nginx). Os caminhos sao relativos ao repo devops-templates.
DEVOPS_TEMPLATE_DEFAULT=pipelines/k8s-app.yaml
DEVOPS_TEMPLATE_DOTNET=
DEVOPS_TEMPLATE_NODE=
DEVOPS_TEMPLATE_PYTHON=
DEVOPS_TEMPLATE_GO=
# Ambientes para os quais gerar environments/<env>/<app>/values.yaml (override fino).
DEVOPS_ENVIRONMENTS=dev,qa,uat,prod
# Passa `language` (dotnet/node/python/go) em extends.parameters da pipeline para
# o template centralizado fazer CI por linguagem. So ative DEPOIS que a tag em
# DEVOPS_TEMPLATES_TAG declarar esse parametro, senao a pipeline gerada quebra.
PIPELINE_PASS_LANGUAGE=false

# ============================================================
# Azure OpenAI (opcional na POC - sem isso, o CLI funciona em modo determinstico)
# ============================================================
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

# ============================================================
# Runtime
# ============================================================
LOG_LEVEL=INFO
WORKDIR_ROOT=./.tmp/sessions
SESSION_TTL_SECONDS=3600
